-- // Construction Farm
local farming = false
local farmThread = nil
local lp = game.Players.LocalPlayer

local function getWallSpot()
	for _, v in pairs(workspace:WaitForChild("ConstructionStuff"):GetChildren()) do
		if v:IsA("Part") and v.Name:find("Wall") then
			local prompt = v:FindFirstChild("Prompt")
			if prompt and prompt.Enabled then
				return v
			end
		end
	end
end

local function tp(cf)
	local char = lp.Character or lp.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	local hrp = char:WaitForChild("HumanoidRootPart")

	hum:ChangeState(0)

	local timeout = 0
	while lp:GetAttribute("LastACPos") and timeout < 2 do
		timeout += task.wait()
	end

	hrp.CFrame = cf
	task.wait(0.1)
	hum:ChangeState(2)
end

local function farmLoop()
	while farming do
		local char = lp.Character or lp.CharacterAdded:Wait()
		local hum = char:FindFirstChild("Humanoid")

		if not hum or hum.Health <= 0 then
			task.wait(0.5)
			continue
		end

		-- Start Job
		if not lp:GetAttribute("WorkingJob") then
			tp(CFrame.new(-1729, 371, -1171))
			task.wait(0.3)

			local start = workspace.ConstructionStuff:FindFirstChild("Start Job")
			if start and start:FindFirstChild("Prompt") then
				fireproximityprompt(start.Prompt)
			end

			repeat task.wait() until lp:GetAttribute("WorkingJob")
		end

		-- Get Wood
		local hasWood = lp.Backpack:FindFirstChild("PlyWood") or char:FindFirstChild("PlyWood")

		if not hasWood then
			tp(CFrame.new(-1728, 371, -1178))

			local grab = workspace.ConstructionStuff:FindFirstChild("Grab Wood")

			repeat
				task.wait()
				if grab and grab:FindFirstChild("Prompt") then
					fireproximityprompt(grab.Prompt)
				end
				hasWood = lp.Backpack:FindFirstChild("PlyWood") or char:FindFirstChild("PlyWood")
			until hasWood
		end

		-- Equip
		local tool = lp.Backpack:FindFirstChild("PlyWood")
		if tool then
			char.Humanoid:EquipTool(tool)
		end

		-- Place
		local spot = getWallSpot()
		if not spot then task.wait(0.3) continue end

		tp(spot.CFrame)

		repeat
			task.wait()
			if spot:FindFirstChild("Prompt") then
				fireproximityprompt(spot.Prompt)
			end
		until not char:FindFirstChild("PlyWood") or not spot.Prompt.Enabled

		task.wait(0.15)
	end
end

